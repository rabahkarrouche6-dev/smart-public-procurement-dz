# Environment Configuration — Smart Public Procurement Platform (Algeria)
APP_ENV=development
DEBUG=True
SECRET_KEY=smart-procurement-insecure-dev-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL default, SQLite fallback for rapid local test)
# For local PostgreSQL: postgresql://postgres:postgres@localhost:5432/smart_procurement_db
DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (Cache & Celery Broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Private Object Storage (MinIO / S3 compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=smart-procurement-private-docs
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# AI Gateway (MVP_FREE tier)
AI_PROVIDER=google
AI_API_KEY=mock-dev-ai-key
AI_MODEL=gemini-1.5-pro

# Email Configuration
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# Sentry Observability
SENTRY_DSN=
